// Notchfax relay server.
// 本地开发（wrangler dev）与测试全部使用本地模拟的 D1 / Durable Object，不需要任何 Cloudflare 账号。
// 只用 D1 + Durable Object + Worker，Cloudflare 免费套餐就够（图片以 BLOB 存 D1，不需要 R2）。
// database_id 指向线上的 notchfax 数据库；换账号部署时要替换，见 README.md 的“部署需要什么”。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notchfax-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // 不记录 IP：关闭 Workers 日志与追踪，代码里也不读取 CF-Connecting-IP 等头。
  "observability": { "enabled": false },

  // 自定义域名（workers.dev 在中国大陆基本连不上）。workers.dev 地址保留，0.1.0 的客户端还在用。
  // 换账号部署时删掉或改成自己的域名。
  "routes": [{ "pattern": "notchfax.liaoxingyi.com", "custom_domain": true }],
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notchfax",
      // 占位符：真实部署时用 `wrangler d1 create notchfax` 返回的 id 替换
      "database_id": "86a9504d-bfba-4d17-94ea-548529a1d241",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "DEVICE_SOCKET", "class_name": "DeviceSocket" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceSocket"] }],

  // 过期清理：线路超时、图片删除、清理旧线路（每 10 分钟一次，每次的工作量有上限）。
  // 本地可用 `--test-scheduled` 触发。
  "triggers": { "crons": ["*/10 * * * *"] },

  "secrets": { "required": ["SESSION_SECRET"] }

  // 密钥 SESSION_SECRET 不写在这里：
  //   本地放 .dev.vars（已被 gitignore，见 .dev.vars.example）
  //   线上用 `wrangler secret put SESSION_SECRET`
}
